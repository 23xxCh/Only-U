    "bloatSource": "cache",
    "tier": "green",
    "action": "clean",
    "notes": "远程插件目录缓存、生成图片与附件残留。"
  },
  {
    "id": "codex-runtime-install-tmp",
    "name": "OpenAI Codex 运行时安装暂存",
    "paths": [
      "%USERPROFILE%\\.cache\\codex-runtimes\\codex-runtime-install-*"
    ],
    "bloatSource": "updater",
    "tier": "green",
    "action": "clean",
    "notes": "codex-runtime-install-* 安装暂存残留（本机实测 114.6MB）；纯浪费，直接删。"
  },
  {
    "id": "codex-runtimes-deps",
    "name": "OpenAI Codex 沙箱运行时",
    "paths": [
      "%USERPROFILE%\\.cache\\codex-runtimes"
    ],
    "bloatSource": "cache",
    "tier": "yellow",
    "action": "migrate",
    "notes": "native/node/python 沙箱运行时（本机 1.33GB）。删了会重新下载，建议 junction 搬走。注意：官方文档未明确该缓存随 CODEX_HOME 走，须单独 junction。"
  },
  {
    "id": "claude-sessions",
    "name": "Claude Code 会话记录",
    "paths": [
      "%USERPROFILE%\\.claude\\projects",
      "%USERPROFILE%\\.claude\\file-history",
      "%USERPROFILE%\\.claude\\transcripts"
    ],
    "bloatSource": "sessions",
    "tier": "red",
    "action": "migrate",
    "notes": "每轮对话+工具调用明文 JSONL。删除丢 /resume 能力且不可逆；只可迁移。cleanupPeriodDays（默认 30 天）到期自动清。"
  },
  {
    "id": "claude-config-auth",
    "name": "Claude Code 配置与登录态",
    "paths": [
      "%USERPROFILE%\\.claude\\settings.json",
      "%USERPROFILE%\\.claude\\credentials",
      "%USERPROFILE%\\.claude.json"
    ],
    "bloatSource": "cache",
    "tier": "red",
    "action": "skip",
    "notes": "必留。settings.json / credentials / .claude.json 删了要重新登录、重配 MCP 与权限。"
  },
  {
    "id": "claude-skills-plugins",
    "name": "Claude Code 技能与插件",
    "paths": [
      "%USERPROFILE%\\.claude\\skills",
      "%USERPROFILE%\\.claude\\plugins"
    ],
    "bloatSource": "cache",
    "tier": "red",
    "action": "skip",
    "notes": "skills 是用户手动安装的资产（调研机 1.28GB，非垃圾）；plugins 谨慎（含用户装的插件）。确认不再需要才手动处理。"
  },
  {
    "id": "claude-tmp-debug",
    "name": "Claude Code 临时与调试残留",
    "paths": [
      "%USERPROFILE%\\.claude\\tmp",
      "%USERPROFILE%\\.claude\\debug",
      "%USERPROFILE%\\.claude\\telemetry",
      "%USERPROFILE%\\.claude\\backups",
      "%USERPROFILE%\\.claude\\shell-snapshots",
      "%USERPROFILE%\\.claude\\paste-cache"
    ],
    "bloatSource": "cache",
    "tier": "green",
    "action": "clean",
    "notes": "tmp/debug/telemetry/backups/shell-snapshots；官方清理步骤认可删除。"
  },
  {
    "id": "claude-versions",
    "name": "Claude Code 旧版本程序目录",
    "paths": [
      "%USERPROFILE%\\.local\\share\\claude\\versions"
    ],
    "bloatSource": "updater",
    "tier": "yellow",
    "action": "clean",
    "notes": "每次升级留一个版本目录、旧版本不自动删（调研机约 0.7-0.9GB）。须保留当前版本：按子目录时间留最新一个再删其余。"
  },
  {
    "id": "continue-index",
    "name": "Continue 代码库嵌入索引",
    "paths": [
      "%USERPROFILE%\\.continue\\index"
    ],
    "bloatSource": "index",
    "tier": "yellow",
    "action": "clean",
    "notes": "index.sqlite 无上限无 GC（社区 20-51GB、极端 300GB+；调研机 2.13GB 即 100% 占用）。删除后重开 VS Code 自动重建；根治：config.yaml 去掉 codebase provider 或配 .continueignore。"
  },
  {
    "id": "continue-config",
    "name": "Continue 配置",
    "paths": [
      "%USERPROFILE%\\.continue\\config.yaml",
      "%USERPROFILE%\\.continue\\skills"
    ],
    "bloatSource": "cache",
    "tier": "red",
    "action": "skip",
    "notes": "必留。"
  },
  {
    "id": "npm-cache",
    "name": "npm 全局缓存",
    "paths": [
      "%LOCALAPPDATA%\\npm-cache"
    ],
    "bloatSource": "cache",
    "tier": "green",
    "action": "clean",
    "notes": "Codex/dsh/pnpm 安装与更新残留（调研机 1.63GB）。推荐 npm cache clean --force；根治：npm config set cache D:\\npm-cache。"
  },
  {
    "id": "claude-cli-nodejs",
    "name": "claude-cli-nodejs 残留",
    "paths": [
      "%LOCALAPPDATA%\\claude-cli-nodejs"
    ],
    "bloatSource": "cache",
    "tier": "green",
    "action": "clean",
    "notes": "claude-cli 历代残留缓存目录。"
  },
  {
