    "bloatSource": "cache",
    "tier": "green",
    "action": "clean",
    "notes": "删除前先退出 codex（WAL 被挂起进程锁住时删了也不释放空间）。社区案例 WAL 数百 GB。"
  },
  {
    "id": "codex-cache",
    "name": "OpenAI Codex 远程插件缓存",
    "paths": [
      "%USERPROFILE%\\.codex\\cache",
      "%USERPROFILE%\\.codex\\generated_images",
      "%USERPROFILE%\\.codex\\attachments"
