[
  {
    "id": "codex-sessions",
    "name": "OpenAI Codex 会话历史",
    "paths": [
      "%USERPROFILE%\\.codex\\sessions",
      "%USERPROFILE%\\.codex\\archived_sessions",
      "%USERPROFILE%\\.codex\\session_index.jsonl"
    ],
    "bloatSource": "sessions",
    "tier": "red",
    "action": "migrate",
    "notes": "头号膨胀源：社区单任务 731GB、computer-use 截图 165GB。删除不可恢复（丢 codex resume），只可 junction 迁移。"
  },
  {
    "id": "codex-config-auth",
    "name": "OpenAI Codex 配置与登录态",
    "paths": [
      "%USERPROFILE%\\.codex\\config.toml",
      "%USERPROFILE%\\.codex\\auth.json"
    ],
    "bloatSource": "cache",
    "tier": "red",
    "action": "skip",
    "notes": "必留。删了要重新登录、重配 provider/模型/信任级别。"
  },
  {
    "id": "codex-tmp",
    "name": "OpenAI Codex 插件暂存",
    "paths": [
      "%USERPROFILE%\\.codex\\.tmp",
      "%USERPROFILE%\\.codex\\tmp"
    ],
    "bloatSource": "cache",
    "tier": "green",
    "action": "clean",
    "notes": "插件暂存、市场捆绑包；自动重建。"
  },
  {
    "id": "codex-plugins-cache",
    "name": "OpenAI Codex 插件缓存",
    "paths": [
      "%USERPROFILE%\\.codex\\plugins"
    ],
    "bloatSource": "cache",
    "tier": "green",
    "action": "clean",
    "notes": "插件安装与缓存（.plugin-appserver、cache\\openai-*）；删除后重下。"
  },
  {
    "id": "codex-sandbox-bin",
    "name": "OpenAI Codex 沙箱辅助二进制",
    "paths": [
      "%USERPROFILE%\\.codex\\.sandbox-bin"
    ],
    "bloatSource": "cache",
    "tier": "green",
    "action": "clean",
    "notes": "codex.exe 副本类辅助二进制；自动重建。"
  },
  {
    "id": "codex-logs-sqlite",
    "name": "OpenAI Codex SQLite 事件日志",
    "paths": [
      "%USERPROFILE%\\.codex\\logs_2.sqlite",
      "%USERPROFILE%\\.codex\\logs_2.sqlite-wal",
      "%USERPROFILE%\\.codex\\logs_2.sqlite-shm",
      "%USERPROFILE%\\.codex\\log",
      "%USERPROFILE%\\.codex\\sandbox.log",
      "%USERPROFILE%\\.codex\\sandbox.2026-05-31.log",
      "%USERPROFILE%\\.codex\\sandbox.2026-07-28.log",
      "%USERPROFILE%\\.codex\\sandbox.2026-08-22.log"
